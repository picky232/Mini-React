{
  "name": "mini-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vanilla JavaScript Mini React learning project",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
