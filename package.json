    "check": "npm run typecheck && npm test",
    "dev": "vite"
  },
  "devDependencies": {
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
